<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MW2023Attachment</AssemblyName>
    <RootNamespace>MW2023Attachment</RootNamespace>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Compile-time references only (ExcludeAssets=runtime): SPT and CommonLib supply these DLLs at runtime. -->
  <ItemGroup>
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="db\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="bundles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="bundles\**\*.bundle" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- After building, lay the mod out ready to drop into SPT: dist\user\mods\MW2023Attachment -->
  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <ModOut>$(MSBuildProjectDirectory)\..\dist\user\mods\$(AssemblyName)\</ModOut>
    </PropertyGroup>
    <ItemGroup>
      <ModRootFiles Include="$(OutDir)$(AssemblyName).dll;$(OutDir)bundles.json" />
      <ModDbFiles Include="$(OutDir)db\**\*" />
      <ModBundleFiles Include="$(OutDir)bundles\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModRootFiles)" DestinationFolder="$(ModOut)" />
    <Copy SourceFiles="@(ModDbFiles)" DestinationFiles="@(ModDbFiles->'$(ModOut)db\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModBundleFiles)" DestinationFiles="@(ModBundleFiles->'$(ModOut)bundles\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
